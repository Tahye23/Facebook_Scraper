      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "if (data.metadata && data.metadata.jsonPath) {",
              "    pm.collectionVariables.set('batch_report_json_path', data.metadata.jsonPath);",
              "}"
            ]
          }
        }
      ]
    },
