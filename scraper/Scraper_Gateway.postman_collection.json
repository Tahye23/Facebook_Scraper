  "item": [
    {
      "name": "Health - GET /actuator/health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/actuator/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": "Vérifie que la gateway est UP."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Job Facebook - POST /scrape",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://www.facebook.com/some-page-or-post\",\n  \"platform\": \"facebook\",\n  \"max_posts\": 5\n}"
        },
        "url": {
          "raw": "{{base_url}}/scrape",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "scrape"
          ]
        },
        "description": "Crée un job de scraping Facebook et récupère scrape_id."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 202', function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "",
              "const data = pm.response.json();",
              "pm.test('Response contains scrape_id', function () {",
              "    pm.expect(data.scrape_id).to.exist;",
              "});",
              "",
              "if (data.scrape_id) {",
              "    pm.collectionVariables.set('scrape_id', data.scrape_id);",
              "    pm.collectionVariables.set('result_cursor', '');",
              "    pm.collectionVariables.set('scrape_id_facebook', data.scrape_id);",
              "    pm.collectionVariables.set('result_cursor_facebook', '');",
              "}"
            ]
          }
        }
      ]
    },
