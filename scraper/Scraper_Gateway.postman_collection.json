    {
      "name": "Get TikTok Batch Metadata - GET /scrape/{scrapeId}",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/scrape/{{scrape_id_tiktok}}",
