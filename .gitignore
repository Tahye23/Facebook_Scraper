# Sensitive session cookies (never commit)
.env
!.env.example
cookies.json
fb_cookies.json
platform/facebook scraper/fb_cookies.json
# Profil Chrome complet (cookies/cache/session Facebook) - jamais committer.
platform/facebook scraper/fb_profile/
platform/tiktok scraper/tiktok_cookies.json
platform/tiktok scraper/tiktok_session_cookies.json
platform/tiktok scraper/diagnostic_results.jsonl
platform/tiktok scraper/diagnostic_metrics.json
platform/tiktok scraper/diagnostic_identity_pool.json
platform/tiktok scraper/identity_pool.json
platform/tiktok scraper/scrape_metrics.json
# Pool Webshare (credentials) + blacklist locale des proxies en cooldown
platform/tiktok scraper/webshare_residential_proxies.txt
platform/tiktok scraper/proxy_blacklist.json
# Artefacts de debug (screenshot/HTML) produits par _save_challenge_artifacts,
# un couple de fichiers par "label" (challenge, no_posts_found, ...).
platform/tiktok scraper/tiktok_*.png
platform/tiktok scraper/tiktok_*.html
platform/tiktok scraper/tiktok_profile/
platform/tiktok scraper/tiktok_sessions/
platform/tiktok scraper/__pycache__/
platform/tiktok scraper/*.pyc
platform/tiktok scraper/video_reports/

# Runtime logs
logs/
*.log

# Python cache artifacts
__pycache__/
*.pyc
