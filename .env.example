# ============================================================================
# MongoDB - stockage des jobs/resultats, requis par le gateway Spring Boot
# ============================================================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me
MONGO_DB=scraper_gateway

# ============================================================================
# RabbitMQ - bus de messages entre le gateway Spring Boot et les workers Python
# ============================================================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# ============================================================================
# Moteur d'extraction TikTok
# ----------------------------------------------------------------------------
# apify     = Apify clockworks/tiktok-profile-scraper (robuste, quota journalier)
# tiktokapi = TikTokApi + sticky residential TIKTOK_PROXY_*  (defaut)
# legacy    = ancien Playwright SSR/XHR/DOM
# NOTE: proxyproviders.Webshare (API /proxy/list) est INCOMPATIBLE avec un plan
# Residential Rotating (p.webshare.io + username/password). Ne pas s'y fier.
# ============================================================================
TIKTOK_ENGINE=tiktokapi
TIKTOK_API_USE_CONTEXT_FACTORY=true
TIKTOK_API_SESSION_TIMEOUT_MS=60000
TIKTOK_API_SLEEP_AFTER=5
TIKTOK_API_MAX_ATTEMPTS=4
TIKTOK_API_BROWSER_CANDIDATES=chromium,webkit
# ms_token: laissez TikTokApi le generer (sleep_after). Ne fixer TIKTOK_MS_TOKEN
# que si TIKTOK_MS_TOKEN_FORCE=true (sinon mismatch sticky frequent).
TIKTOK_MS_TOKEN_FORCE=false
# TIKTOK_MS_TOKEN=
TIKTOK_SCRAPE_SUBPROCESS_LOG_STDERR=true

# ============================================================================
# Apify — moteur alternatif (TIKTOK_ENGINE=apify)
# Actor: clockworks/tiktok-profile-scraper
# Token: console.apify.com → Settings → Integrations (jamais committer)
# ============================================================================
# TIKTOK_ENGINE=apify
APIFY_TOKEN=
APIFY_ACTOR_ID=0FXVyOXXEmdGcV88a
APIFY_DAILY_VIDEO_LIMIT=30
APIFY_POLL_INTERVAL_S=5
APIFY_RUN_TIMEOUT_S=180
APIFY_QUOTA_FILE=apify_quota.json

# ============================================================================
# Proxies Webshare — Rotating Residential Endpoint (recommande)
# ----------------------------------------------------------------------------
# Host Rotating Residential (dashboard Webshare): p.webshare.io:80 + user *-rotate
# (chaque session = nouvelle IP). HTTP:80 OBLIGATOIRE (Chromium refuse SOCKS5 auth).
# Format Playwright: server=http://host:80 + username/password separes.
# Mode legacy pool 20k: TIKTOK_PROXY_MODE=pool + TIKTOK_PROXY_FILE=...
# Ignoré quand TIKTOK_ENGINE=apify (Apify gère sa propre infra).
# ============================================================================
TIKTOK_PROXY_MODE=rotate
TIKTOK_PROXY_URL=http://your_webshare_username-rotate:your_webshare_password@p.webshare.io:80
TIKTOK_PROXY_HOST=p.webshare.io
TIKTOK_PROXY_PREFER_SOCKS5=false
TIKTOK_PROXY_PORT=80
TIKTOK_PROXY_SERVER=http://p.webshare.io:80
TIKTOK_PROXY_USERNAME=your_webshare_username-rotate
TIKTOK_PROXY_PASSWORD=your_webshare_password
TIKTOK_PROXY_BLACKLIST_ENABLED=false
TIKTOK_PROXY_FILE=
TIKTOK_PROXY_LIST=
TIKTOK_BATCH_CONCURRENCY=6

# ============================================================================
# Proxy local de rotation IPv6 (tools/ipv6_rotating_proxy.py) - alternative a
# TIKTOK_PROXY_LIST ci-dessus, utile seulement si vous avez un bloc /64 route
# (ex: OVHcloud) et pas de proxies tiers. Tourne en systemd DIRECTEMENT SUR
# L'HOTE (pas dans Docker): voir tools/setup_ipv6_anyip.sh et
# tools/systemd/ipv6-rotating-proxy.service.
# ============================================================================
IPV6_PROXY_PREFIX=
IPV6_PROXY_LISTEN_HOST=127.0.0.1
IPV6_PROXY_LISTEN_PORT=1080
# manual: adresse fixe jusqu'a un appel explicite a /rotate (recommande, pilote
# par TIKTOK_IPV6_ROTATE_EVERY_N_POSTS). Autres valeurs: per_connection | per_host | sticky
IPV6_PROXY_ROTATE_MODE=manual
IPV6_PROXY_CONTROL_PORT=8091

# ============================================================================
# Gemini - analyse de contenu video
# ============================================================================
GEMINI_API_KEY=replace_with_real_key
GEMINI_MODEL=gemini-2.5-flash
TIKTOK_ANALYZE_VIDEO_CONTENT=true
# 0 desactive l'analyse; negatif = analyser tous les posts demandes
TIKTOK_ANALYZE_VIDEO_LIMIT=-1
VIDEO_ANALYSIS_OUTPUT_DIR=platform/tiktok scraper/video_reports

# ============================================================================
# Batch / resilience - retries job unique, retries batch CSV, rotation IPv6
# ============================================================================
TIKTOK_JOB_MAX_ATTEMPTS=3
TIKTOK_JOB_RETRY_BACKOFF_SECONDS=10
TIKTOK_BATCH_FINAL_RETRY_ENABLED=true
TIKTOK_BATCH_FINAL_RETRY_DELAY_SECONDS=20
# Rotation d'identite IPv6 toutes les N videos (0 = desactive)
TIKTOK_IPV6_ROTATE_EVERY_N_POSTS=0
TIKTOK_IPV6_ROTATE_CONTROL_URL=http://127.0.0.1:8091/rotate
# Le defaut 60 remplace l'ancienne limite fixe de 8, necessaire pour laisser
# le temps a plusieurs rotations IPv6 de se produire sur un gros profil/batch.
TIKTOK_MAX_SCROLL_ITERATIONS=60
TIKTOK_MAX_EMPTY_SCROLLS=3
TIKTOK_ASYNC_ENRICHMENT_ENABLED=true
TIKTOK_ENRICHMENT_WORKERS=2

# ============================================================================
# Comportement du navigateur TikTok - vital pour eviter la detection anti-bot
# ============================================================================
TIKTOK_HEADLESS=true
# Session TikTok "chauffee" reutilisee entre chaque run, au lieu d'un contexte
# ephemere qui ressemble a un nouveau bot a chaque scrape. Chemin relatif
# resolu par rapport au dossier "tiktok scraper".
TIKTOK_USER_DATA_DIR=tiktok_profile
TIKTOK_APPLY_STEALTH=false
TIKTOK_FORCE_COOKIE_INJECTION=false
TIKTOK_ENRICH_POST_DETAILS=true
TIKTOK_ENRICH_POST_DETAILS_LIMIT=6
# false = n'ouvrir /video/<id> que si metrics/texte absents du profil
ENRICH_VIDEO_PAGE_ALWAYS=false
TIKTOK_OEMBED_FALLBACK=true
PAGE_GOTO_TIMEOUT=15000
TIKTOK_PAGE_GOTO_TIMEOUT_MS=15000
# Tentatives (= nouvelles IP) via l'endpoint rotatif / job
MAX_PROXY_RETRIES=5
TIKTOK_PROXY_MAX_PER_JOB=5
TIKTOK_PROXY_ATTEMPTS_PER_PROXY=1
ENABLE_MOBILE_FALLBACK=false
PURGE_STICKY_ON_BLOCK=true
# true = modele historique cookies-par-IP (persist + reuse apres warmup)
TIKTOK_REUSE_STICKY_COOKIES=true
TIKTOK_WARMUP_WAIT_MS=4000
TIKTOK_MANUAL_SOLVE_WAIT_SECONDS=0
TIKTOK_WAIT_CHALLENGE_RESOLVE_SECONDS=0
# --- anti-detection-v2 (MVP bandwidth-aware) ---
# Timeout dur worker: kill subprocess scrape+Chrome apres N secondes (defaut 90).
TIKTOK_JOB_HARD_TIMEOUT_S=280
# Alias recommande (prioritaire dans worker.py):
WORKER_HARD_TIMEOUT_S=280
# Budget: TIKTOK_API_MAX_ATTEMPTS(4) * (SESSION_TIMEOUT 60s + ~10s marge) ≈ 280s.
# Ne pas redescendre sous 240s tant que MAX_ATTEMPTS=4, sinon la derniere
# tentative est tuee par HARD TIMEOUT et fausse le taux soft_block.
# true = scrape dans subprocess isole (kill tree au timeout). false = thread legacy.
TIKTOK_SCRAPE_SUBPROCESS=true
# Watchdog Chrome orphelins (filet si kill principal echoue).
TIKTOK_CHROME_WATCHDOG_ENABLED=true
TIKTOK_CHROME_ORPHAN_MAX_MINUTES=10
TIKTOK_CHROME_WATCHDOG_INTERVAL_S=60
# Bloque image/media/font Playwright pour economiser le quota 10GB/mois.
# Toggle runtime sans rebuild: true|false (aussi via diagnostic --test-mode assets_off).
TIKTOK_BLOCK_HEAVY_ASSETS=true
# Identity pool minimal (session sticky → virgin/warm/active/quarantine/dead).
TIKTOK_IDENTITY_POOL_ENABLED=true
TIKTOK_IDENTITY_POOL_FILE=identity_pool.json
TIKTOK_IDENTITY_QUARANTINE_HOURS=24
# Cooldown reuse apres soft_block / structural_change (heures).
TIKTOK_QUARANTINE_COOLDOWN_HOURS=2
# Metriques locales + alerte derive multi-pays.
TIKTOK_SCRAPE_METRICS_FILE=scrape_metrics.json
TIKTOK_METRICS_DRIFT_MIN_COUNTRIES=3
TIKTOK_METRICS_DRIFT_WINDOW_S=3600
# Alerte soft quand bandwidth cumule approche le plafond (MB).
TIKTOK_BANDWIDTH_CAP_MB=9000
# Diagnostic logged_in (jamais committer le fichier cookies):
# TIKTOK_DIAG_SESSION_COOKIES_FILE=platform/tiktok scraper/tiktok_session_cookies.json

# le script doit-il tenter d'utiliser ta propre connexion internet en dernier recours ?
# false : le script s'arrete en cas d'echec des proxies.
# true : il tente de charger TikTok avec ta vraie adresse IP en dernier recours.
TIKTOK_TRY_DIRECT_AFTER_PROXIES=false

# ============================================================================
# Logs
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_DIR=logs
LOG_FILE=
LOG_ROTATION_MB=10
LOG_BACKUP_COUNT=5

# ============================================================================
# Avance / optionnel
# ============================================================================
# WEBSHARE_API_KEY: laisser VIDE si TIKTOK_PROXY_MODE=rotate (Residential Rotating).
# proxyproviders.Webshare (/proxy/list) est INCOMPATIBLE avec p.webshare.io sticky.
# WEBSHARE_API_KEY=
# Duree de cache d'une adresse IPv6 en mode IPV6_PROXY_ROTATE_MODE=per_host uniquement.
IPV6_PROXY_HOST_TTL_SECONDS=300
