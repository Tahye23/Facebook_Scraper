    {
      "name": "Create CSV Batch Report TikTok - POST /scrape/csv-report",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "{{csv_file_path}}",
              "description": "CSV file containing TikTok profile URLs"
            },
            {
              "key": "maxPostsPerPage",
              "value": "{{max_posts_per_page}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/scrape/csv-report",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "scrape",
            "csv-report"
          ]
        },
        "description": "Cree un job batch CSV TikTok et retourne scrape_id + nombre d'URLs detectees."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 202', function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Response contains scrape_id', function () {",
              "    pm.expect(data.scrape_id).to.exist;",
