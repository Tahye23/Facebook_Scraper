    {
      "name": "Stream Facebook Results - GET /scrape/{scrapeId}/results/stream",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/scrape/{{scrape_id_facebook}}/results/stream?cursor={{result_cursor_facebook}}&limit=5&waitMs=15000",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "scrape",
            "{{scrape_id_facebook}}",
            "results",
            "stream"
          ],
          "query": [
            {
              "key": "cursor",
              "value": "{{result_cursor_facebook}}"
            },
            {
              "key": "limit",
              "value": "5"
            },
            {
              "key": "waitMs",
              "value": "15000"
            }
          ]
        },
        "description": "Nouveaux résultats Facebook en mode progressif (RabbitMQ -> DB)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.next_cursor !== undefined) {",
              "    pm.collectionVariables.set('result_cursor_facebook', data.next_cursor || '');",
              "}"
            ]
          }
        }
      ]
    },
