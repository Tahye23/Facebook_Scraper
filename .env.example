# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me
MONGO_DB=scraper_gateway

# RabbitMQ (used by gateway and local TikTok worker)
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# TikTok scraping runtime
TIKTOK_HEADLESS=false
# Pointez ceci vers le proxy local de tools/ipv6_rotating_proxy.py pour
# beneficier de la rotation d'adresse source IPv6 (voir section IPv6 plus bas).
# Exemple: TIKTOK_PROXY_SERVER=socks5://127.0.0.1:1080
TIKTOK_PROXY_SERVER=
TIKTOK_PROXY_USERNAME=
TIKTOK_PROXY_PASSWORD=
TIKTOK_PROXY_LIST=
# le script doit-il tenter d'utiliser ta propre connexion internet locale ?
# false : Le script s'arrête en cas d'échec des proxies.
# true : En dernier recours, il tente de charger TikTok avec ta vraie adresse IP.
TIKTOK_TRY_DIRECT_AFTER_PROXIES=false

# Persistent browser profile (recommended in production): reuses cookies/session
# across runs instead of a fresh ephemeral context each time (looks less bot-like).
# Relative path is resolved against the tiktok scraper folder, not the process cwd.
TIKTOK_USER_DATA_DIR=tiktok_profile
TIKTOK_FORCE_COOKIE_INJECTION=false
TIKTOK_MANUAL_SOLVE_WAIT_SECONDS=0
TIKTOK_WAIT_CHALLENGE_RESOLVE_SECONDS=0
TIKTOK_APPLY_STEALTH=false
TIKTOK_ENRICH_POST_DETAILS=true
TIKTOK_ENRICH_POST_DETAILS_LIMIT=6

# Resilience: retries au niveau job unique (POST /scrape) avant d'abandonner
# si 0 post n'a pu etre recupere.
TIKTOK_JOB_MAX_ATTEMPTS=3
TIKTOK_JOB_RETRY_BACKOFF_SECONDS=10

# Resilience: round de retry final applique aux pages en echec d'un batch CSV
# (csv-report / csv-report-24h) apres un temps de "refroidissement".
TIKTOK_BATCH_FINAL_RETRY_ENABLED=true
TIKTOK_BATCH_FINAL_RETRY_DELAY_SECONDS=20

# Proxy local de rotation IPv6 (tools/ipv6_rotating_proxy.py). A definir
# uniquement sur les serveurs disposant d'un bloc /64 route (ex: OVHcloud).
# Voir tools/ipv6_rotating_proxy.py et tools/setup_ipv6_anyip.sh.
IPV6_PROXY_PREFIX=
IPV6_PROXY_LISTEN_HOST=127.0.0.1
IPV6_PROXY_LISTEN_PORT=1080
# per_connection | per_host | sticky | manual
IPV6_PROXY_ROTATE_MODE=manual
IPV6_PROXY_HOST_TTL_SECONDS=300
IPV6_PROXY_CONTROL_PORT=8091

# Rotation d'identite IPv6 pilotee depuis scraper.py: toutes les N videos
# collectees, fermeture + reouverture du contexte Playwright avec une
# nouvelle IPv6 (demandee au proxy ci-dessus via TIKTOK_IPV6_ROTATE_CONTROL_URL).
# 0 = desactive (comportement d'origine, aucun changement de reseau en cours
# de scrape).
TIKTOK_IPV6_ROTATE_EVERY_N_POSTS=0
TIKTOK_IPV6_ROTATE_CONTROL_URL=http://127.0.0.1:8091/rotate

# Bornes de la boucle de scroll (le defaut de 60 remplace l'ancienne limite
# fixe de 8, necessaire pour laisser le temps a plusieurs rotations IPv6 de
# se produire sur un gros profil / batch 24h).
TIKTOK_MAX_SCROLL_ITERATIONS=60
TIKTOK_MAX_EMPTY_SCROLLS=3

# Per-post TikTok video analysis
TIKTOK_ANALYZE_VIDEO_CONTENT=true
# 0 disables analysis; negative means analyze all posts requested by payload
TIKTOK_ANALYZE_VIDEO_LIMIT=-1
VIDEO_ANALYSIS_OUTPUT_DIR=platform/tiktok scraper/video_reports
TIKTOK_ASYNC_ENRICHMENT_ENABLED=true
TIKTOK_ENRICHMENT_WORKERS=2

# visual model settings
VIDEO_ANALYSIS_ENABLE_GEMINI_VISUAL=false
GEMINI_API_KEY=replace_with_real_key
GEMINI_MODEL=gemini-2.5-flash

# General logging (all platforms)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_DIR=logs
LOG_FILE=
LOG_ROTATION_MB=10
LOG_BACKUP_COUNT=5
