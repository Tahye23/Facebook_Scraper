    {
      "name": "Stream Results (cursor + long-poll) - GET /scrape/{scrapeId}/results/stream",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/scrape/{{scrape_id}}/results/stream?cursor={{result_cursor}}&limit=5&waitMs=15000",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "scrape",
            "{{scrape_id}}",
            "results",
            "stream"
          ],
          "query": [
            {
              "key": "cursor",
              "value": "{{result_cursor}}",
              "description": "Cursor returned by previous stream call (empty for first call)"
            },
            {
              "key": "limit",
              "value": "5"
            },
            {
              "key": "waitMs",
              "value": "15000",
              "description": "Long-poll wait time in ms (0..30000)"
            }
          ]
        },
        "description": "Requête générique de stream basée sur scrape_id/result_cursor. Dans cette collection mixte, préfère Stream Facebook Results ou Stream TikTok Results pour éviter toute confusion de variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Response has results array', function () {",
              "    pm.expect(data.results).to.be.an('array');",
              "});",
              "if (data.next_cursor !== undefined) {",
              "    pm.collectionVariables.set('result_cursor', data.next_cursor || '');",
              "}"
            ]
          }
        }
      ]
    },
