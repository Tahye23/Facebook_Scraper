# ─── MongoDB ───────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=mongo
MONGO_DB=scraper_gateway

# ─── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# TikTok anti-bot: prefer a residential/mobile proxy.
# Single proxy formats supported:
# TIKTOK_PROXY_SERVER=http://host:port
# TIKTOK_PROXY_USERNAME=user
# TIKTOK_PROXY_PASSWORD=pass
# Or inline URI/list formats:
# TIKTOK_PROXY_LIST=http://user:pass@host1:port1
# TIKTOK_PROXY_LIST=http://user:pass@host1:port1;http://user:pass@host2:port2
TIKTOK_HEADLESS=true
TIKTOK_PROXY_SERVER=
TIKTOK_PROXY_USERNAME=
TIKTOK_PROXY_PASSWORD=
TIKTOK_PROXY_LIST=
TIKTOK_TRY_DIRECT_AFTER_PROXIES=false

# Local TikTok run (outside Docker) with your real browser profile.
# Example Windows path:
# TIKTOK_USER_DATA_DIR=C:/Users/HP_LAPTOP/Desktop/Facebook_Scraper/platform/tiktok scraper/tiktok_profile
TIKTOK_USER_DATA_DIR=
TIKTOK_FORCE_COOKIE_INJECTION=false
TIKTOK_MANUAL_SOLVE_WAIT_SECONDS=0
TIKTOK_WAIT_CHALLENGE_RESOLVE_SECONDS=0
TIKTOK_APPLY_STEALTH=false
TIKTOK_ENRICH_POST_DETAILS=true
TIKTOK_ENRICH_POST_DETAILS_LIMIT=6

# Per-post TikTok video analysis during page scraping
TIKTOK_ANALYZE_VIDEO_CONTENT=true
TIKTOK_ANALYZE_VIDEO_LIMIT=2
VIDEO_ANALYSIS_OUTPUT_DIR=platform/tiktok scraper/video_reports
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

# Optional multimodal visual analyzer (Gemini)
VIDEO_ANALYSIS_ENABLE_GEMINI_VISUAL=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
